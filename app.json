{
  "expo": {
    "name": "RaftOff Social",
    "slug": "raftoff-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "raftoff",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raftoff.social",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RaftOff uses your location only while the app is open so you can Drop Anchor at nearby Lake St. Clair destinations. Location is never required in the background."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050A0F"
      },
      "package": "com.raftoff.social",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "react-native-maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RaftOff to use your location while using the app to Drop Anchor near Lake St. Clair places."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
