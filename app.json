{
  "expo": {
    "name": "RaftOff Social",
    "slug": "raftoff-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "raftoff",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raftoff.social",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "RaftOff",
        "LSApplicationQueriesSchemes": ["raftoff"],
        "NSLocationWhenInUseUsageDescription": "RaftOff uses your location only while the app is open so you can Drop Anchor at nearby Lake St. Clair destinations. Location is never required in the background.",
        "NSPhotoLibraryUsageDescription": "Allow RaftOff to choose photos for your profile, boat, check-ins, and events.",
        "NSCameraUsageDescription": "Allow RaftOff to take photos for your profile, boat, check-ins, and events.",
        "NSUserTrackingUsageDescription": "RaftOff does not track you across other companies’ apps or websites for advertising.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050A0F"
      },
      "package": "com.raftoff.social",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RaftOff to upload profile, boat, and check-in photos.",
          "cameraPermission": "Allow RaftOff to take photos for your profile, boat, and check-ins."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RaftOff to use your location while using the app to Drop Anchor near Lake St. Clair places.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "replace-with-eas-project-id"
      },
      "privacyPolicyUrl": "https://raftoffsocial.com/privacy",
      "termsOfServiceUrl": "https://raftoffsocial.com/terms",
      "supportUrl": "https://raftoffsocial.com",
      "supportEmail": "privacy@raftoffsocial.com"
    }
  }
}
