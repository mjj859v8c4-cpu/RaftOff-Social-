# RaftOff Social — public client env only.
# NEVER put service-role keys, database passwords, or SMTP secrets in EXPO_PUBLIC_* vars.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Optional observability
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Site URL used for OAuth redirects / email links (marketing)
EXPO_PUBLIC_SITE_URL=https://raftoff.social
