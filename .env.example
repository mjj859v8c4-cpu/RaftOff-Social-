# Public site URL used for canonical links, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://rochestermobileautorepair.com

# Resend (https://resend.com) — server-side only, never expose to the client
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Rochester Mobile Auto Repair <requests@your-verified-domain.com>"

# Where appointment and contact submissions are delivered
BOOKING_INBOX_EMAIL=owner@yourdomain.com
CONTACT_INBOX_EMAIL=owner@yourdomain.com

# Optional: allow console email fallback in production (not recommended)
# ALLOW_DEV_EMAIL_FALLBACK=false
